# Supabase project URL and publishable (anon) key.
# VITE_ variables are public in the browser; never put a service_role key here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-key"

# Supabase PostgreSQL connection string from Project Settings -> Database.
# Use the Session pooler if the host cannot connect directly to an IPv6 database endpoint.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres?sslmode=require"

# Required for AI generation.
GEMINI_API_KEY="your-gemini-api-key"
# Optional model override. The latest Flash alias avoids pinning the app to a busy model.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional: Meta / Instagram Graph API credentials.
# META_APP_ID="your_meta_app_id"
# META_APP_SECRET="your_meta_app_secret"
# META_REDIRECT_URI="https://yourdomain.com/api/v1/instagram/callback"
